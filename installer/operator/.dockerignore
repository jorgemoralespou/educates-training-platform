# More info: https://docs.docker.com/engine/reference/builder/#dockerignore-file
# Ignore everything by default and re-include only needed files
**

# Re-include Go source files (but not *_test.go)
!**/*.go
**/*_test.go

# Re-include Go module files
!go.mod
!go.sum

# Re-include vendored upstream Helm chart tarballs. The operator
# //go:embed-s these at build time (see vendored-charts/embed.go);
# without this rule docker build fails with
# "pattern <name>.tgz: no matching files found".
!vendored-charts/*.tgz

# Re-include the operator's embedded CRDs. The operator //go:embed-s these
# (see internal/crds/crds.go) and applies them at startup; without this rule
# docker build fails with "pattern files/*.yaml: no matching files found".
!internal/crds/files/*.yaml
